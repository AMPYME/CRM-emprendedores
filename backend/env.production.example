# ============================================
# Emprendedores CRM — PRODUCCIÓN (Dokploy)
# ============================================
# Plantilla: copia estos valores al panel de Dokploy / .env del servidor.
# NO pongas contraseñas reales aquí (este archivo puede ir al repositorio).
#
# Dominios de ejemplo:
#   Front: http://emprendedores.ampyme.local
#   API:   http://api-emprendedores.ampyme.local
#
# DATABASE_URL = conexión del BACKEND a PostgreSQL (no es el login del CRM).
# El login de usuarios es exclusivo vía Active Directory (AD_API_BASE_URL).
#
# HOSTNAME: un solo nombre del servicio Postgres en Dokploy (NO concatenar dos servicios).
# Ejemplo correcto:  @emprendedores-jaykcb:5432
# Ejemplo incorrecto: @emprendedores-dbemprendedores-jaykcb:5432
#
# Si aparece P3009 (baseline fallido): redeploy con el entrypoint actual, o ejecute una vez
#   sh scripts/prod-fix-migrations.sh
#
# Nota: este backend NO usa JWT_REFRESH_SECRET (solo JWT_SECRET).

# Servidor
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL (red interna Docker/Dokploy — NO localhost desde fuera del contenedor)
# Formato: postgresql://USUARIO:CONTRASEÑA@HOSTNAME:5432/NOMBRE_BD?schema=public
# El USUARIO suele ser "postgres" (no "postgre"). El HOSTNAME es el del servicio DB
# en Dokploy (ej. emprendedores-postgres-xxxxx), no el dominio público.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/emprendedores_db?schema=public

# JWT (secreto largo y aleatorio; distinto del de desarrollo)
JWT_SECRET=CAMBIAR_POR_SECRETO_LARGO_Y_ALEATORIO_MIN_32_CHARS
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Orígenes del frontend (navegador). Docker/Dokploy inyecta esta variable.
# Debe coincidir EXACTO con window.location.origin (sin path).
CORS_ORIGIN=http://emprendedores.ampyme.local

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── AD-userAPI (login corporativo al CRM) ──
# Debe ser la API de usuarios AD, NO la API del CRM.
AD_API_BASE_URL=http://api-adusers.ampyme.local
AD_EMAIL_DOMAIN=ampyme.gob.pa
AD_REQUIRED_APP_ROLES=EMPREND_OPERADOR,EMPREND_VIEWER,EMPREND_ADMIN,ADMIN,SUPER_ADMIN
AD_AUTO_PROVISION=true
# AD_SKIP_ROLE_CHECK=true

# ── Login central Entra (el navegador) ──
# Este backend llama a ENTRA por DNS. El navegador abre https://users.ampyme.local.
# El frontend de Emprendedores es http://emprendedores.ampyme.local.
# El portal de administración es https://portal.ampyme.local.
ENTRA_API_BASE_URL=http://login.ampyme.local
# Mismos nombres que en ENTRA-userAPI. No copies AZURE_CLIENT_ID, AZURE_TENANT_ID ni AZURE_CLIENT_SECRET.
EMPRENDEDORES_CLIENT_ID=00000000-0000-4000-8000-000000000004
EMPRENDEDORES_APP_SECRET=CAMBIAR_POR_EL_MISMO_VALOR_DE_ENTRA
ENTRA_REQUIRED_APP_ROLES=EMPREND_OPERADOR,EMPREND_VIEWER,EMPREND_ADMIN,ADMIN,SUPER_ADMIN
ENTRA_AUTO_PROVISION=true

# Nunca en producción:
# ENTRA_SKIP_ROLE_CHECK=true

# ── Intake (PostgreSQL + WebSocket) ──
WS_PATH=/ws/intake
INTAKE_SESSION_TTL_MIN=20

# ── Backup PostgreSQL (opcional — cron en servidor) ──
# BACKUP_LOCAL_DIR=/var/backups/emprendedores
# BACKUP_REMOTE_HOST=backup.ampyme.local
# BACKUP_REMOTE_USER=backup
# BACKUP_REMOTE_PATH=/backups/emprendedores
# BACKUP_RETENTION_DAYS=7
