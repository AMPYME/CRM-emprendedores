// ============================================================================
// Emprendedores CRM — Schema de Prisma
// ============================================================================
// Modelo de datos maestro para el sistema de cartera/CRM.
// Patrón: Table-per-Type (TPT) con entities como tabla polimórfica.
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum EntityType {
  PERSON
  COMPANY
}

enum CompanySizeClass {
  MICRO
  PEQUENA
  MEDIANA
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  VERIFICATION_CLAIM
  VERIFICATION_UPDATE
  VERIFICATION_VALIDATE
  VERIFICATION_REJECT
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  DUPLICATE
  MERGED
}

enum ContactType {
  EMAIL
  PHONE
  MOBILE
  WHATSAPP
  WEBSITE
  SOCIAL_MEDIA
  OTHER
}

/// Tipos de vínculo entre entidades (personas, empresas).
/// Pares soportados:
/// - PERSON → PERSON | COMPANY
/// - COMPANY → COMPANY | PERSON
/// Unicidad: a lo sumo un vínculo por par de entidades (también se rechaza el inverso).
/// Una entidad puede vincularse a múltiples destinos permitidos sin repetir el mismo par.
enum RelationshipType {
  OWNER           // Dueño(a) — tip. persona→empresa/establecimiento
  EMPLOYEE        // Empleado(a) — tip. persona→empresa/establecimiento
  PARTNER         // Socio(a) — persona↔empresa o empresa↔empresa
  BRANCH          // Sucursal — tip. establecimiento→empresa (o establecimiento→establecimiento)
  REPRESENTATIVE  // Representante legal / comercial
  RELATED         // Relacionado (persona↔persona, genérico entre entidades)
  SUBSIDIARY      // Subsidiaria / filiar — tip. empresa→empresa o establecimiento→empresa
  AFFILIATED      // Afiliado — tip. empresa↔empresa o establecimiento↔establecimiento
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  CONFIRMED
  ATTENDED
  NO_SHOW
  CANCELLED
}

enum PortfolioStatus {
  NEW
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum PortfolioPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActionType {
  CALL
  EMAIL_ACTION
  VISIT
  MEETING
  WHATSAPP
  NOTE
  DOCUMENT
  STATUS_CHANGE
  OTHER
}

enum ImportStatus {
  PENDING
  PROCESSING
  VALIDATING
  DEDUPLICATING
  REVIEW_REQUIRED
  IMPORTING
  VERIFICATION_QUEUED
  COMPLETED
  FAILED
  CANCELLED
}

enum StagingRowStatus {
  PENDING
  VALID
  INVALID
  DUPLICATE_EXACT
  DUPLICATE_POSSIBLE
  IMPORTED
  QUEUED_FOR_VERIFICATION
  SKIPPED
  ERROR
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EMPREND_ADMIN
  EMPREND_OPERADOR
  EMPREND_VIEWER
}

// ============================================================================
// AUTENTICACIÓN Y USUARIOS
// ============================================================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  username     String?
  role         UserRole @default(EMPREND_OPERADOR)
  isActive     Boolean  @default(true) @map("is_active")
  sedeId          String?  @map("sede_id")
  departamentoId  String?  @map("departamento_id")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relaciones
  sede                     Sede?             @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  departamento             Departamento?     @relation(fields: [departamentoId], references: [id], onDelete: SetNull)
  portfolioRecordsAssigned PortfolioRecord[] @relation("AssignedTo")
  portfolioActions         PortfolioAction[] @relation("ActionPerformedBy")
  importBatches            ImportBatch[]     @relation("ImportedBy")
  createdEntities          Entity[]          @relation("CreatedBy")
  auditLogs                AuditLog[]
  verificationItemsAssigned VerificationItem[] @relation("VerificationAssignedTo")
  verificationItemsDeleted  VerificationItem[] @relation("VerificationDeletedBy")
  contactsDeleted           EntityContact[]    @relation("ContactDeletedBy")
  registrationsDeleted      EventRegistration[] @relation("RegistrationDeletedBy")
  importsDeleted            ImportBatch[]      @relation("ImportDeletedBy")
  intakeSessionsDeleted     IntakeSession[]    @relation("IntakeDeletedBy")

  @@index([username])
  @@map("users")
}

/// Registro de auditoría de acciones en el CRM (solo visible para ADMIN).
model AuditLog {
  id          String      @id @default(uuid())
  action      AuditAction
  entityType  String?     @map("entity_type")
  entityId    String?     @map("entity_id")
  entityLabel String?     @map("entity_label")
  userId      String?     @map("user_id")
  userEmail   String?     @map("user_email")
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at")

  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// ENTIDADES MAESTRAS (Patrón Table-per-Type)
// ============================================================================

/// Tabla maestra de entidades. Cada registro es una persona o empresa.
/// Los datos específicos van en la tabla hija correspondiente.
model Entity {
  id              String       @id @default(uuid())
  entityType      EntityType   @map("entity_type")
  status          EntityStatus @default(ACTIVE)
  displayName     String       @map("display_name")

  // Ubicación geográfica — códigos FK al catálogo (codProv 2, codDist 4, codCorr 6)
  province        String?   @db.Char(2)  @map("cod_prov")
  district        String?   @db.Char(4)  @map("cod_dist")
  corregimiento   String?   @db.Char(6)  @map("cod_corr")
  address         String?

  // Trazabilidad
  notes           String?
  registroEmpresarialFecha DateTime? @map("registro_empresarial_fecha") @db.Date
  sourceOrigin    String?      @map("source_origin")  // Ej: "IMPORTACION_DIRECTORIO_2024", "EVENTO_CUMBRE_2024", "MANUAL"
  importBatchId   String?      @map("import_batch_id")
  mergedIntoId    String?      @map("merged_into_id")  // Si fue fusionada con otra entidad
  createdById     String?      @map("created_by_id")

  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relaciones
  person          Person?
  company         Company?
  contacts        EntityContact[]
  relationshipsFrom EntityRelationship[] @relation("RelationFrom")
  relationshipsTo   EntityRelationship[] @relation("RelationTo")
  eventRegistrations EventRegistration[]
  portfolioRecords   PortfolioRecord[]
  importBatch     ImportBatch?   @relation(fields: [importBatchId], references: [id])
  mergedInto      Entity?        @relation("MergedEntity", fields: [mergedIntoId], references: [id])
  mergedFrom      Entity[]       @relation("MergedEntity")
  createdBy       User?          @relation("CreatedBy", fields: [createdById], references: [id])
  stagingRows     StagingRow[]   @relation("MatchedEntity")
  provinciaCatalog     Provincia?     @relation("EntityProvincia", fields: [province], references: [codProv], onDelete: SetNull)
  distritoCatalog      Distrito?      @relation("EntityDistrito", fields: [district], references: [codDist], onDelete: SetNull)
  corregimientoCatalog Corregimiento? @relation("EntityCorregimiento", fields: [corregimiento], references: [codCorr], onDelete: SetNull)

  @@index([entityType])
  @@index([status])
  @@index([displayName])
  @@index([province])
  @@index([sourceOrigin])
  @@index([importBatchId])
  @@map("entities")
}

/// Datos específicos de personas naturales.
model Person {
  id              String    @id @default(uuid())
  entityId        String    @unique @map("entity_id")
  cedula          String?   // Cédula panameña — puede no estar disponible
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  secondLastName  String?   @map("second_last_name")
  gender          Gender?
  birthDate       DateTime? @map("birth_date")
  nationalityCode String    @default("PAN") @map("nationality_code") @db.Char(3)
  educationLevel  String?   @map("education_level")

  // Datos laborales/emprendimiento (opcionales, útil para CRM)
  occupation      String?
  businessName    String?   @map("business_name")   // Nombre del negocio si lo tiene
  economicActivity String?  @map("economic_activity")
  hasArtisanCard   Boolean?  @map("has_artisan_card")
  seedCapital      Int?      @map("seed_capital")
  seedCapitalDate  String?   @map("seed_capital_date") @db.VarChar(7)

  // Relación
  entity          Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  capitalSemilla  CapitalSemilla?

  @@index([cedula])
  @@index([firstName, lastName])
  @@index([lastName])
  @@map("persons")
}

/// Datos específicos de empresas / personas jurídicas.
model Company {
  id               String    @id @default(uuid())
  entityId         String    @unique @map("entity_id")
  ruc              String?   // RUC — puede no estar disponible
  dv               String?   // Dígito verificador
  legalName        String    @map("legal_name")
  tradeName        String?   @map("trade_name")
  companyType      String?           @map("company_type")      // S.A., S.EP., INC., Corp., S. de R.L.
  companySizeClass CompanySizeClass? @map("company_size_class")
  economicActivity String?           @map("economic_activity")
  foundedDate      DateTime?         @map("founded_date")
  employeeCount    Int?              @map("employee_count")

  // Relación
  entity           Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([ruc])
  @@index([legalName])
  @@index([tradeName])
  @@map("companies")
}

// ============================================================================
// CONTACTOS Y RELACIONES
// ============================================================================

/// Contactos de una entidad (email, teléfono, web, etc.).
/// Una entidad puede tener múltiples contactos de cada tipo.
model EntityContact {
  id            String      @id @default(uuid())
  entityId      String      @map("entity_id")
  contactType   ContactType @map("contact_type")
  contactValue  String      @map("contact_value")
  label         String?     // Ej: "Personal", "Trabajo", "WhatsApp negocio"
  isPrimary     Boolean     @default(false) @map("is_primary")
  isVerified    Boolean     @default(false) @map("is_verified")
  deletedAt     DateTime?   @map("deleted_at")
  deletedById   String?     @map("deleted_by_id")

  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  // Relación
  entity        Entity      @relation(fields: [entityId], references: [id], onDelete: Cascade)
  deletedBy     User?       @relation("ContactDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([entityId])
  @@index([contactType, contactValue])
  @@index([contactValue])
  @@index([deletedAt])
  @@index([deletedById])
  @@map("entity_contacts")
}

/// Relaciones dirigidas entre entidades polimórficas (`entities`).
/// Unicidad en DB: una fila por par lógico, sin importar si se intenta A→B o B→A.
/// El índice funcional `entity_relationships_unordered_pair_key` se define en
/// la migración porque Prisma no representa índices sobre LEAST/GREATEST.
/// Cada entidad puede tener múltiples vínculos con destinos distintos.
model EntityRelationship {
  id               String           @id @default(uuid())
  fromEntityId     String           @map("from_entity_id")
  toEntityId       String           @map("to_entity_id")
  relationshipType RelationshipType @map("relationship_type")
  role             String?          // Rol específico: "Gerente", "Contador", "Sucursal Norte"
  startDate        DateTime?        @map("start_date")
  endDate          DateTime?        @map("end_date")
  isActive         Boolean          @default(true) @map("is_active")

  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relaciones
  fromEntity       Entity           @relation("RelationFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity         Entity           @relation("RelationTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@unique([fromEntityId, toEntityId])
  @@index([fromEntityId])
  @@index([toEntityId])
  @@index([relationshipType])
  @@map("entity_relationships")
}

// ============================================================================
// EVENTOS
// ============================================================================

/// Evento (feria, capacitación, cumbre, taller, etc.).
model Event {
  id              String      @id @default(uuid())
  name            String
  slug            String      @unique
  description     String?
  eventType       String?     @map("event_type")    // Feria, Capacitación, Taller, Cumbre
  status          EventStatus @default(DRAFT)
  startDate       DateTime?   @map("start_date")
  endDate         DateTime?   @map("end_date")
  location        String?
  province        String?
  maxCapacity     Int?        @map("max_capacity")

  /// Campos dinámicos del formulario de inscripción (JSON schema).
  /// Permite definir preguntas adicionales por evento.
  formFields      Json?       @map("form_fields")

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relaciones
  registrations   EventRegistration[]

  @@index([status])
  @@index([startDate])
  @@map("events")
}

/// Registro/inscripción de una entidad a un evento.
model EventRegistration {
  id                 String             @id @default(uuid())
  eventId            String             @map("event_id")
  entityId           String             @map("entity_id")
  status             RegistrationStatus @default(REGISTERED)
  registeredAt       DateTime           @default(now()) @map("registered_at")
  confirmedAt        DateTime?          @map("confirmed_at")
  attendedAt         DateTime?          @map("attended_at")
  notes              String?

  // Trazabilidad de importación
  sourceOrigin       String?            @map("source_origin")
  importBatchId      String?            @map("import_batch_id")
  deletedAt          DateTime?          @map("deleted_at")
  deletedById        String?            @map("deleted_by_id")

  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  // Relaciones
  event              Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entity             Entity             @relation(fields: [entityId], references: [id], onDelete: Cascade)
  answers            EventRegistrationAnswer[]
  importBatch        ImportBatch?        @relation(fields: [importBatchId], references: [id])
  deletedBy          User?               @relation("RegistrationDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // Unicidad de inscripciones activas: índice parcial en la migración
  // event_registrations_active_event_entity_key (deleted_at IS NULL).
  @@index([eventId])
  @@index([entityId])
  @@index([status])
  @@index([deletedAt])
  @@index([deletedById])
  @@map("event_registrations")
}

/// Respuestas a los campos dinámicos del formulario de un evento.
model EventRegistrationAnswer {
  id              String            @id @default(uuid())
  registrationId  String            @map("registration_id")
  fieldKey        String            @map("field_key")    // Clave del campo en form_fields
  fieldLabel      String            @map("field_label")  // Etiqueta legible
  value           String            // Valor de la respuesta

  createdAt       DateTime          @default(now()) @map("created_at")

  // Relaciones
  registration    EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId, fieldKey])
  @@index([registrationId])
  @@map("event_registration_answers")
}

// ============================================================================
// CARTERA / SEGUIMIENTO
// ============================================================================

/// Registro de cartera vinculado a una entidad.
/// Representa una gestión/caso/seguimiento activo.
model PortfolioRecord {
  id               String           @id @default(uuid())
  entityId         String           @map("entity_id")
  assignedToId     String?          @map("assigned_to_id")
  status           PortfolioStatus  @default(NEW)
  priority         PortfolioPriority @default(MEDIUM)
  category         String?          // Categoría de gestión
  subject          String           // Asunto/motivo
  description      String?
  nextFollowUpDate DateTime?        @map("next_follow_up_date")
  closedAt         DateTime?        @map("closed_at")
  closedReason     String?          @map("closed_reason")
  sedeId           String?          @map("sede_id")
  departamentoId   String?          @map("departamento_id")

  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relaciones
  entity           Entity           @relation(fields: [entityId], references: [id], onDelete: Cascade)
  assignedTo       User?            @relation("AssignedTo", fields: [assignedToId], references: [id])
  sede             Sede?            @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  departamento     Departamento?    @relation(fields: [departamentoId], references: [id], onDelete: SetNull)
  actions          PortfolioAction[]

  @@index([entityId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([nextFollowUpDate])
  @@index([sedeId])
  @@index([departamentoId])
  @@map("portfolio_records")
}

/// Sede institucional. El borrado es lógico (`deleted_at`).
model Sede {
  id        String    @id @default(uuid())
  name      String
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  users             User[]
  portfolioRecords  PortfolioRecord[]
  portfolioActions  PortfolioAction[]

  @@index([deletedAt])
  @@map("sedes")
}

/// Departamento institucional. El borrado es lógico (`deleted_at`).
model Departamento {
  id        String    @id @default(uuid())
  name      String
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  users            User[]
  portfolioRecords PortfolioRecord[]
  portfolioActions PortfolioAction[]

  @@index([deletedAt])
  @@map("departamentos")
}

/// Acción/gestión realizada sobre un registro de cartera.
model PortfolioAction {
  id              String          @id @default(uuid())
  portfolioId     String          @map("portfolio_id")
  performedById   String?         @map("performed_by_id")
  actionType      ActionType      @map("action_type")
  description     String
  result          String?
  nextSteps       String?         @map("next_steps")
  actionDate      DateTime        @default(now()) @map("action_date")
  sedeId          String?         @map("sede_id")
  departamentoId  String?         @map("departamento_id")

  createdAt       DateTime        @default(now()) @map("created_at")

  // Relaciones
  portfolio       PortfolioRecord @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  performedBy     User?           @relation("ActionPerformedBy", fields: [performedById], references: [id])
  sede            Sede?           @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  departamento    Departamento?   @relation(fields: [departamentoId], references: [id], onDelete: SetNull)

  @@index([portfolioId])
  @@index([performedById])
  @@index([actionDate])
  @@index([sedeId])
  @@index([departamentoId])
  @@map("portfolio_actions")
}

// ============================================================================
// IMPORTACIONES
// ============================================================================

/// Lote de importación. Cada carga de Excel genera un registro aquí.
model ImportBatch {
  id               String       @id @default(uuid())
  fileName         String       @map("file_name")
  originalFileName String       @map("original_file_name")
  sourceType       String       @map("source_type")       // "DIRECTORIO", "EVENTO_CUMBRE", "EVENTO_CRECE", etc.
  targetEventId    String?      @map("target_event_id")   // Si la importación es para un evento
  status           ImportStatus @default(PENDING)
  totalRows        Int          @default(0) @map("total_rows")
  validRows        Int          @default(0) @map("valid_rows")
  invalidRows      Int          @default(0) @map("invalid_rows")
  duplicateRows    Int          @default(0) @map("duplicate_rows")
  importedRows     Int          @default(0) @map("imported_rows")
  skippedRows      Int          @default(0) @map("skipped_rows")
  errorLog         Json?        @map("error_log")
  columnMapping    Json?        @map("column_mapping")    // Mapeo de columnas Excel → campos del sistema
  importedById     String?      @map("imported_by_id")
  deletedAt        DateTime?    @map("deleted_at")
  deletedById      String?      @map("deleted_by_id")

  startedAt        DateTime?    @map("started_at")
  completedAt      DateTime?    @map("completed_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  // Relaciones
  importedBy       User?        @relation("ImportedBy", fields: [importedById], references: [id])
  deletedBy        User?        @relation("ImportDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  stagingRows      StagingRow[]
  entities         Entity[]
  eventRegistrations EventRegistration[]
  verificationItems VerificationItem[]

  @@index([status])
  @@index([sourceType])
  @@index([importedById])
  @@index([deletedAt])
  @@index([deletedById])
  @@map("import_batches")
}

/// Fila de staging (carga cruda de Excel).
/// Cada fila del Excel se guarda aquí antes de procesarse.
model StagingRow {
  id               String          @id @default(uuid())
  importBatchId    String          @map("import_batch_id")
  rowNumber        Int             @map("row_number")
  status           StagingRowStatus @default(PENDING)

  // Datos crudos del Excel (normalizados pero sin procesar)
  rawData          Json            @map("raw_data")        // Toda la fila como JSON

  // Campos extraídos/mapeados (para facilitar deduplicación)
  extractedCedula       String?    @map("extracted_cedula")
  extractedRuc          String?    @map("extracted_ruc")
  extractedFirstName    String?    @map("extracted_first_name")
  extractedLastName     String?    @map("extracted_last_name")
  extractedEmail        String?    @map("extracted_email")
  extractedPhone        String?    @map("extracted_phone")
  extractedBusinessName String?    @map("extracted_business_name")

  // Resultado de validación y deduplicación
  validationErrors Json?           @map("validation_errors")
  matchedEntityId  String?         @map("matched_entity_id")
  matchScore       Float?          @map("match_score")     // Score de similitud (0-1)
  matchReason      String?         @map("match_reason")    // Ej: "cedula_exacta", "email_exacto", "nombre_fuzzy"

  processedAt      DateTime?       @map("processed_at")
  deletedAt        DateTime?       @map("deleted_at")
  createdAt        DateTime        @default(now()) @map("created_at")

  // Relaciones
  importBatch      ImportBatch     @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  matchedEntity    Entity?         @relation("MatchedEntity", fields: [matchedEntityId], references: [id])
  verificationItems VerificationItem[]

  @@index([importBatchId])
  @@index([status])
  @@index([extractedCedula])
  @@index([extractedRuc])
  @@index([extractedEmail])
  @@index([extractedPhone])
  @@index([deletedAt])
  @@map("staging_rows")
}

// ============================================================================
// DIVISIÓN POLÍTICA DE PANAMÁ (catálogo)
// IDs = códigos del JSON oficial (codProv 2, codDist 4, codCorr 6).
// ============================================================================

model Provincia {
  codProv   String     @id @db.Char(2)
  nombre    String     @db.VarChar(100)

  distritos Distrito[]
  entities  Entity[]   @relation("EntityProvincia")

  @@map("provincias")
}

model Distrito {
  codDist   String    @id @db.Char(4)
  nombre    String    @db.VarChar(100)

  codProv   String    @db.Char(2)
  provincia Provincia @relation(fields: [codProv], references: [codProv], onDelete: Restrict)

  corregimientos Corregimiento[]
  entities       Entity[]        @relation("EntityDistrito")

  @@index([codProv])
  @@map("distritos")
}

model Corregimiento {
  codCorr  String   @id @db.Char(6)
  nombre   String   @db.VarChar(150)

  codDist  String   @db.Char(4)
  distrito Distrito @relation(fields: [codDist], references: [codDist], onDelete: Restrict)
  entities Entity[] @relation("EntityCorregimiento")

  @@index([codDist])
  @@map("corregimientos")
}

// ============================================================================
// INTAKE TEMPORAL (formulario público → validación CRM)
// ============================================================================

enum IntakeSessionStatus {
  DRAFT
  SUBMITTED
  VALIDATED
  EXPIRED
}

/// Sesión pública de captura. El enlace usa `id` (sid); todas las lecturas
/// y escrituras exigen el código de 6 dígitos (hash SHA-256).
model IntakeSession {
  id             String              @id @default(uuid())
  entityType     EntityType          @default(PERSON) @map("entity_type")
  status         IntakeSessionStatus @default(DRAFT)
  createdBy      String?             @map("created_by") @db.VarChar(120)
  accessCodeHash String?             @map("access_code_hash") @db.Char(64)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  lastActivityAt DateTime            @default(now()) @map("last_activity_at")
  expiresAt      DateTime            @map("expires_at")
  deletedAt      DateTime?           @map("deleted_at")
  deletedById    String?             @map("deleted_by_id")

  entities       IntakeEntity[]
  verificationItem VerificationItem?
  deletedBy      User?               @relation("IntakeDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([expiresAt])
  @@index([lastActivityAt])
  @@index([createdBy])
  @@index([deletedAt])
  @@index([deletedById])
  @@map("intake_sessions")
}

model IntakeEntity {
  id            String     @id @default(uuid())
  sessionId     String     @map("session_id")
  entityType    EntityType @default(PERSON) @map("entity_type")
  displayName   String?    @map("display_name") @db.VarChar(255)
  province      String?    @db.VarChar(120)
  district      String?    @db.VarChar(120)
  corregimiento String?    @db.VarChar(120)
  address       String?
  notes         String?
  sourceOrigin  String     @default("EMPRENDEDORES_INTAKE") @map("source_origin") @db.VarChar(120)
  deletedAt     DateTime?  @map("deleted_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  session         IntakeSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  person          IntakePerson?
  company         IntakeCompany?
  contacts        IntakeContact[]
  relationshipsFrom IntakeRelationship[] @relation("IntakeRelationFrom")
  relationshipsTo   IntakeRelationship[] @relation("IntakeRelationTo")

  @@index([sessionId])
  @@index([entityType])
  @@index([deletedAt])
  @@map("intake_entities")
}

model IntakePerson {
  id               String    @id @default(uuid())
  intakeEntityId   String    @unique @map("intake_entity_id")
  cedula           String?   @db.VarChar(40)
  firstName        String?   @map("first_name") @db.VarChar(120)
  lastName         String?   @map("last_name") @db.VarChar(120)
  secondLastName   String?   @map("second_last_name") @db.VarChar(120)
  gender           Gender?
  birthDate        DateTime? @map("birth_date") @db.Date
  nationalityCode  String    @default("PAN") @map("nationality_code") @db.Char(3)
  educationLevel   String?   @map("education_level") @db.VarChar(120)
  occupation       String?   @db.VarChar(160)
  businessName     String?   @map("business_name") @db.VarChar(200)
  economicActivity String?   @map("economic_activity") @db.VarChar(200)
  hasArtisanCard   Boolean?  @map("has_artisan_card")
  seedCapital      Int?      @map("seed_capital")
  seedCapitalDate  String?   @map("seed_capital_date") @db.VarChar(7)

  entity IntakeEntity @relation(fields: [intakeEntityId], references: [id], onDelete: Cascade)

  @@map("intake_persons")
}

model IntakeCompany {
  id               String    @id @default(uuid())
  intakeEntityId   String    @unique @map("intake_entity_id")
  ruc              String?   @db.VarChar(60)
  dv               String?   @db.VarChar(10)
  legalName        String?   @map("legal_name") @db.VarChar(200)
  tradeName        String?   @map("trade_name") @db.VarChar(200)
  companyType      String?           @map("company_type") @db.VarChar(80)
  companySizeClass CompanySizeClass? @map("company_size_class")
  economicActivity String?           @map("economic_activity") @db.VarChar(200)
  foundedDate      DateTime?         @map("founded_date") @db.Date
  employeeCount    Int?              @map("employee_count")

  entity IntakeEntity @relation(fields: [intakeEntityId], references: [id], onDelete: Cascade)

  @@map("intake_companies")
}

model IntakeContact {
  id             String      @id @default(uuid())
  intakeEntityId String      @map("intake_entity_id")
  contactType    ContactType @map("contact_type")
  contactValue   String      @map("contact_value")
  label          String?
  isPrimary      Boolean     @default(false) @map("is_primary")

  entity IntakeEntity @relation(fields: [intakeEntityId], references: [id], onDelete: Cascade)

  @@index([intakeEntityId])
  @@map("intake_contacts")
}

model IntakeRelationship {
  id               String           @id @default(uuid())
  fromEntityId     String           @map("from_entity_id")
  toEntityId       String           @map("to_entity_id")
  relationshipType RelationshipType @map("relationship_type")
  role             String?
  startDate        DateTime?        @map("start_date")
  endDate          DateTime?        @map("end_date")
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  fromEntity IntakeEntity @relation("IntakeRelationFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity   IntakeEntity @relation("IntakeRelationTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@index([fromEntityId])
  @@index([toEntityId])
  @@map("intake_relationships")
}

// ============================================================================
// COLA DE VERIFICACIÓN (importaciones + captura en campo)
// ============================================================================

enum VerificationSource {
  IMPORT
  FIELD
}

enum VerificationStatus {
  PENDING
  ASSIGNED
  IN_REVIEW
  VALIDATED
  REJECTED
}

/// Registro pendiente de verificación antes de crear Persona/Empresa en el CRM.
model VerificationItem {
  id                String             @id @default(uuid())
  entityType        EntityType         @map("entity_type")
  source            VerificationSource
  status            VerificationStatus @default(PENDING)

  importBatchId     String?            @map("import_batch_id")
  stagingRowId      String?            @map("staging_row_id")

  assignedToId      String?            @map("assigned_to_id")
  assignedAt        DateTime?          @map("assigned_at")

  intakeSessionId   String?            @unique @map("intake_session_id")

  /// Snapshot precargado (formato intake) + metadatos de importación
  data              Json

  province          String?            @db.Char(2)  @map("cod_prov")
  district          String?            @db.Char(4)  @map("cod_dist")
  corregimiento     String?            @db.Char(6)  @map("cod_corr")

  displayName       String?            @map("display_name") @db.VarChar(255)
  searchCedula      String?            @map("search_cedula") @db.VarChar(40)
  searchRuc         String?            @map("search_ruc") @db.VarChar(60)
  searchText        String?            @map("search_text") @db.VarChar(500)

  validatedEntityId String?            @map("validated_entity_id")
  validatedAt       DateTime?          @map("validated_at")
  rejectedAt        DateTime?          @map("rejected_at")
  rejectionReason   String?            @map("rejection_reason")
  deletedAt         DateTime?          @map("deleted_at")
  deletedById       String?            @map("deleted_by_id")

  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  importBatch       ImportBatch?       @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  stagingRow        StagingRow?        @relation(fields: [stagingRowId], references: [id], onDelete: SetNull)
  assignedTo        User?              @relation("VerificationAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  deletedBy         User?              @relation("VerificationDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  intakeSession     IntakeSession?     @relation(fields: [intakeSessionId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([source])
  @@index([entityType])
  @@index([assignedToId])
  @@index([importBatchId])
  @@index([province])
  @@index([district])
  @@index([corregimiento])
  @@index([createdAt])
  @@index([status, source, entityType])
  @@index([searchCedula])
  @@index([searchRuc])
  @@index([deletedAt])
  @@index([deletedById])
  @@map("verification_items")
}

/// Registro histórico de Capital Semilla, vinculado a la persona por cédula.
model CapitalSemilla {
  id           String   @id @default(uuid())
  externalId   Int?     @map("external_id")
  cedula       String
  cedulaKey    String   @map("cedula_key")
  province     String?
  businessName String?  @map("business_name")
  actaNumber   String?  @map("acta_number")
  amount       Decimal? @db.Decimal(12, 2)
  personId     String?  @unique @map("person_id")
  createdAt    DateTime @default(now()) @map("created_at")

  person       Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([cedulaKey])
  @@map("capital_semilla")
}
