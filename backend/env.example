# ============================================
# Emprendedores CRM - Variables de Entorno
# ============================================
# Copiar: cp env.example .env

# Servidor
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Base de datos PostgreSQL
# App (cutover): rol crm_api — solo schema api (views/functions/procedures)
# DATABASE_URL=postgresql://crm_api:cambiar_crm_api@localhost:5432/emprendedores_db
# Migraciones DDL:
# DATABASE_MIGRATE_URL=postgresql://crm_migrator:cambiar_crm_migrator@localhost:5432/emprendedores_db?schema=public
# Desarrollo (owner, transición):
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/emprendedores_db?schema=public
# Backend local (sin Docker): host = localhost y puerto expuesto
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emprendedores_db?schema=public

# Consulta pública registro-empresarial (sin JWT): rol solo-EXECUTE sobre
# public.fn_validar_registro_empresarial(text). Creado por migración Prisma.
# Contraseña inicial de migración: cambiar_rempresarial_viewer
# ALTER ROLE rempresarial_viewer PASSWORD 'secreto-seguro';
# ALTER ROLE crm_api PASSWORD 'secreto-seguro';
# ALTER ROLE crm_migrator PASSWORD 'secreto-seguro';
# REMPresarial_VIEWER_URL=postgresql://rempresarial_viewer:secreto@localhost:5432/emprendedores_db
# CRM_API_DATABASE_URL=postgresql://crm_api:cambiar_crm_api@localhost:5432/emprendedores_db

# JWT (el CRM emite sus propios tokens tras validar AD)
JWT_SECRET=cambiar-en-produccion-secreto-seguro-min-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── AD-userAPI (login corporativo) ──
# Misma URL que proxy-users-api.php / Forms (USERS_API_URL): sin /api al final.
AD_API_BASE_URL=http://api-adusers.ampyme.local

# Dominio si el usuario escribe solo el login sin @
AD_EMAIL_DOMAIN=ampyme.gob.pa

# Roles en GET /api/auth/me → user.roles (al menos uno; separados por coma)
AD_REQUIRED_APP_ROLES=EMPREND_OPERADOR,EMPREND_VIEWER,EMPREND_ADMIN,ADMIN,SUPER_ADMIN

# Crear usuario en CRM si existe en AD pero no en la BD local
AD_AUTO_PROVISION=true

# Solo desarrollo: no exigir rol de aplicación
# AD_SKIP_ROLE_CHECK=true

# AD-userAPI en el host (npm run dev del API en :3000):
# AD_API_BASE_URL=http://host.docker.internal:3000

# ── Intake de Emprendedores (PostgreSQL + WebSocket) ──
# Ruta del WebSocket de intake (servido por el backend en el mismo puerto)
WS_PATH=/ws/intake

# Minutos de inactividad tras los que expira una sesión de intake
INTAKE_SESSION_TTL_MIN=20

# ── Formularios AMPYME (MySQL directo, misma BD que forms-app) ──
FORMS_MYSQL_HOST=192.168.2.184
FORMS_MYSQL_PORT=3306
FORMS_MYSQL_USER=app_user
FORMS_MYSQL_PASSWORD=app_password
FORMS_MYSQL_DATABASE=forms_ampyme

# ── Importaciones (procesamiento por lotes) ──
IMPORT_BATCH_SIZE=25
IMPORT_BATCH_DELAY_MS=150
IMPORT_STAGING_INSERT_BATCH_SIZE=200
