# ============================================
# Emprendedores CRM - Variables de Entorno
# ============================================
# Copiar este archivo como .env y ajustar valores

# Servidor
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Base de datos PostgreSQL
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:55555/emprendedores_db?schema=public

# JWT
JWT_SECRET=cambiar-en-produccion-secreto-seguro-min-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
# Puede ser un solo origen o una lista separada por comas, por ejemplo:
# CORS_ORIGIN=http://localhost:3000,http://192.168.99.60:3000
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
