# Ejemplo nginx delante del frontend (IP pública 10.14.86.10).
# El navegador NO habla con 10.14.80.245 directo: todo va same-origin.
#
# upstream front  → contenedor Next (puerto 80)
# upstream api    → backend Dokploy / 10.14.80.245:4000 (o el host interno)

upstream emprendedores_front {
    server 127.0.0.1:3000;   # ajustar al puerto del contenedor frontend
}

upstream emprendedores_api {
    server 10.14.80.245:4000; # o hostname Docker del backend
}

server {
    listen 80;
    server_name 10.14.86.10;

    # REST → backend (el JS usa /backend-api)
    location /backend-api/ {
        proxy_pass http://emprendedores_api/api/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket intake → backend (el JS usa ws://<este-host>/ws/intake)
    location /ws/intake {
        proxy_pass http://emprendedores_api/ws/intake;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400;
    }

    location / {
        proxy_pass http://emprendedores_front;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
